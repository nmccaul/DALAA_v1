# Copy to .env.local. Never commit real values.

# Postgres. Any Postgres works (D-007). On Vercel with the Supabase
# integration you can leave this unset: the app falls back to POSTGRES_URL.
# Run migrations against POSTGRES_URL_NON_POOLING (direct, port 5432).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dalaa

# Signs the session cookie. 32+ random characters: `openssl rand -base64 32`
SESSION_SECRET=

# Test sign-in (type a NetID, no BYU login) until Okta is registered (D-016).
# Required to be paired with DEV_SIGN_IN_PASSWORD on any deployed site.
DEV_SIGN_IN=1
DEV_SIGN_IN_PASSWORD=

# Connections per server instance (default 5).
# DATABASE_POOL_MAX=5

# Real Canvas (D-004). Practice Canvas needs no setting; it lives at /practice-canvas.
CANVAS_BASE_URL=https://byu.instructure.com

# Encrypts teachers' Canvas tokens at rest: openssl rand -base64 32
CANVAS_TOKEN_KEY=

# Origin of this app, no trailing slash (http://localhost:3000 locally).
APP_URL=

# --- LTI 1.3 (D-020). Platform = the Canvas that launches DALAA. ---
LTI_PLATFORM_URL=
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=
# base64 of a PKCS8 PEM RSA private key: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64
LTI_PRIVATE_KEY=

# Canvas API developer key for OAuth2 (reading course pages and files).
CANVAS_OAUTH_CLIENT_ID=
CANVAS_OAUTH_CLIENT_SECRET=

# --- AI through Vercel AI Gateway (D-026). Production uses Vercel OIDC. ---
AI_GATEWAY_API_KEY=
# AI Gateway model strings, e.g. google/gemini-3.8-flash and openai/gpt-6.1-sol
CHAT_MODEL=
GRADER_MODEL=

# --- Sign-in outside Canvas: Supabase Auth (D-022). Server-side only. ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only these email domains may create an account, comma-separated (e.g. byu.edu).
# Signing in needs no school domain once a signed-in user set a password (D-029).
SCHOOL_EMAIL_DOMAINS=

# Shared test teacher (D-023). Test-only: remove before the pilot.
TEST_TEACHER_EMAIL=
TEST_TEACHER_PASSWORD=

# Shared test student (D-029), never staff. Test-only: remove before the pilot.
TEST_STUDENT_EMAIL=
TEST_STUDENT_PASSWORD=
